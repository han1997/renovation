<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 启动主题：与 Compose Theme 协同，启动瞬间避免白闪。
         真实视觉由代码侧 RenovationTheme + dynamicLightColorScheme 控制。 -->
    <style name="Theme.Renovation" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg_cream</item>
        <item name="android:windowBackground">@color/bg_cream</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>